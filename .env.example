# auto = OpenAI when OPENAI_API_KEY is set, otherwise the offline mock agents
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# For LLM_PROVIDER=bedrock (build with WITH_BEDROCK=true). Uses the standard AWS credential chain.
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
AWS_REGION=us-east-1
WITH_BEDROCK=false

# Claims with a payable amount above this go to a senior handler
SENIOR_REVIEW_THRESHOLD=300000
LLM_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
